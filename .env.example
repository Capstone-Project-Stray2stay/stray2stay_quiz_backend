ENV=development
ADDR=:8081

# Same MongoDB the main stray2stay backend uses - this service only reads
# the catBreeds/dogBreeds collections (breed name + reference images).
MONGO_DB_URI=
MONGO_DB_NAME=

# Frontend origin allowed to call this API (comma-separate for multiple).
ORIGIN=http://localhost:5180

# Secret used to HMAC-sign stateless question tokens. Generate with e.g.
# `openssl rand -base64 32`. Keep separate from the main backend's secrets.
QUIZ_TOKEN_SECRET=
QUIZ_TOKEN_TTL_MINUTES=10
